generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  password  String
  role      String   @default("penyewa") // "admin" | "penyewa"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentals             Rental[]
  rentalStatusActions RentalStatusHistory[] @relation("RentalStatusActor")
  sessions            UserSession[]
}

model Equipment {
  id          String   @id @default(uuid())
  name        String
  category    String // e.g., "Traktor", "Mesin Tanam", "Pompa Air", "Panen"
  dailyRate   Int
  description String
  imageUrl    String
  imageUrls   Json?
  isActive    Boolean  @default(true)
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units       EquipmentUnit[]
  rentals     Rental[]
  categoryRef EquipmentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
}

model EquipmentCategory {
  id         String      @id @default(uuid())
  name       String      @unique @db.VarChar(60)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  equipments Equipment[]
}

model EquipmentUnit {
  id              String   @id @default(uuid())
  equipmentId     String
  unitCode        String   @unique // e.g. "UNT-TKT-001"
  conditionStatus String   @default("aktif") // "aktif", "perawatan", "rusak", "nonaktif"
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  equipment            Equipment             @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  rentals              Rental[]
  maintenanceSchedules MaintenanceSchedule[]
}

model Rental {
  id              String   @id @default(uuid())
  orderCode       String   @unique // e.g. "ORD-20261002-001"
  userId          String
  equipmentId     String?
  unitId          String?
  startDate       DateTime
  endDate         DateTime
  durationDays    Int
  dailyRate       Int
  totalRentalFee  Int
  rentalStatus    String   @default("menunggu_persetujuan") // "menunggu_persetujuan", "menunggu_pembayaran", "siap_diambil", "sedang_disewa", "pemeriksaan_pengembalian", "selesai"
  exceptionStatus String? // "ditolak", "dibatalkan", "kedaluwarsa"
  rejectReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User                  @relation(fields: [userId], references: [id])
  equipmentRef  Equipment?            @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  unit          EquipmentUnit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  payment       Payment?
  returnRecord  ReturnRecord?
  requestKey    String?               @unique @db.VarChar(64)
  statusHistory RentalStatusHistory[]
}

model RentalStatusHistory {
  id         String   @id @default(uuid())
  rentalId   String
  actorId    String?
  fromStatus String?
  toStatus   String
  reason     String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  actor  User?  @relation("RentalStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([rentalId, createdAt])
}

model Payment {
  id                   String    @id @default(uuid())
  rentalId             String    @unique
  snapToken            String?
  amount               Int
  paymentStatus        String    @default("belum_dibayar") // "belum_dibayar", "tertunda", "berhasil", "gagal", "kedaluwarsa"
  paymentMethod        String?
  paidAt               DateTime?
  paymentDeadline      DateTime?
  gatewayTransactionId String?   @db.VarChar(120)
  gatewayStatus        String?   @db.VarChar(40)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  rental        Rental                @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  gatewayEvents PaymentGatewayEvent[]
}

model PaymentGatewayEvent {
  id                String   @id @default(uuid())
  paymentId         String
  eventKey          String   @unique @db.VarChar(64)
  transactionId     String   @db.VarChar(120)
  transactionStatus String   @db.VarChar(40)
  statusCode        String   @db.VarChar(12)
  grossAmount       String   @db.VarChar(32)
  processingResult  String   @db.VarChar(40)
  receivedAt        DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, receivedAt])
}

model ReturnRecord {
  id                    String   @id @default(uuid())
  rentalId              String   @unique
  actualReturnDate      DateTime @default(now())
  lateDays              Int      @default(0)
  lateFee               Int      @default(0)
  damageFee             Int      @default(0)
  totalFine             Int      @default(0)
  finePaymentStatus     String   @default("belum_dibayar") // "belum_dibayar", "lunas"
  initialConditionNotes String
  finalConditionNotes   String
  adminNotes            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
}

model UserSession {
  id        String    @id @default(uuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LoginRateBucket {
  key          String   @id @db.VarChar(64)
  attempts     Int      @default(0)
  windowEndsAt DateTime
  updatedAt    DateTime @updatedAt
}

model MaintenanceSchedule {
  id        String   @id @default(uuid())
  unitId    String
  startDate DateTime
  endDate   DateTime
  reason    String   @db.VarChar(500)
  status    String   @default("terjadwal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit EquipmentUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, startDate, endDate])
}
