{
  "name": "tanisewa-penyewaan-alat-tani",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "lint": "next lint frontend && next lint backend",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "db:push": "prisma db push --schema backend/prisma/schema.prisma",
    "start:backend": "next start backend -p 4001",
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma",
    "dev:backend": "next dev backend -p 4001",
    "start:frontend": "next start frontend -p 3000",
    "db:seed": "prisma db seed --schema backend/prisma/schema.prisma",
    "dev:frontend": "next dev frontend -p 3000",
    "build:frontend": "next build frontend",
    "build:backend": "next build backend",
    "start": "concurrently -k -n backend,frontend -c blue,green \"npm:start:backend\" \"npm:start:frontend\""
  },
  "dependencies": {
    "@next/env": "^14.2.15",
    "@prisma/client": "^5.20.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.8",
    "lucide-react": "^0.453.0",
    "midtrans-client": "^1.3.1",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "node backend/prisma/seed.js"
  }
}
